# .streamlit/secrets.toml にコピーして値を入れる（secrets.toml は Git に入れないこと）
SUPABASE_URL = "https://xxxxxxxx.supabase.co"
SUPABASE_KEY = "sb_publishable_..."   # Supabase の Publishable key（旧 anon キー）。Secret key はここに入れない
ADMIN_PASSCODE = "十分に長いランダムな文字列"

# --- AI要約（使う場合だけ、行頭の # を消して値を入れる。両方入れると画面で切り替えられる）---
# AI_PROVIDER = "claude"               # 既定で使うAI: "claude" または "openai"
# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-opus-5-5"  # 省略時はこの値
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-5"               # 使えるモデル名は OpenAI のドキュメントで確認して設定
